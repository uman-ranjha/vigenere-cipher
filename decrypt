#!/usr/bin/env python3
"""
decrypt - reverse the byte-wise Vigenere cipher.

Usage:
    ./decrypt <ciphertext_file> <keyfile> > <recovered_plaintext>

Encryption added the key byte mod 256, so decryption subtracts it:
    p_i = (c_i - k_(i mod n)) mod 256

Python's % always returns a value in 0..255 even when c_i - k is
negative, so the wrap-around is handled automatically. The output is
byte-for-byte identical to the original file.
"""

import sys


def vigenere_decrypt(data, key):
    """Shift each byte backward by the matching key byte, wrapping at 256."""
    n = len(key)
    return bytes((b - key[i % n]) % 256 for i, b in enumerate(data))


def main():
    if len(sys.argv) != 3:
        sys.stderr.write("Usage: ./decrypt <ciphertext_file> <keyfile> > <recovered_plaintext>\n")
        sys.exit(1)

    with open(sys.argv[1], "rb") as f:
        ciphertext = f.read()
    with open(sys.argv[2], "rb") as f:
        key = f.read()

    if len(key) == 0:
        sys.stderr.write("Error: key file is empty\n")
        sys.exit(1)

    sys.stdout.buffer.write(vigenere_decrypt(ciphertext, key))


if __name__ == "__main__":
    main()
