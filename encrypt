#!/usr/bin/env python3
"""
encrypt - byte-wise Vigenere encryption of any file.

Usage:
    ./encrypt <plaintext_file> <keyfile> > <ciphertext_file>

For each byte p_i of the input and key K = <k_0, ..., k_(n-1)>:
    c_i = (p_i + k_(i mod n)) mod 256

The ciphertext is written to stdout as raw bytes and is the same
length as the plaintext. Works on any file type (text, images, PDFs...).
"""

import sys


def vigenere_encrypt(data, key):
    """Shift each byte forward by the matching key byte, wrapping at 256."""
    n = len(key)
    return bytes((b + key[i % n]) % 256 for i, b in enumerate(data))


def main():
    if len(sys.argv) != 3:
        sys.stderr.write("Usage: ./encrypt <plaintext_file> <keyfile> > <ciphertext_file>\n")
        sys.exit(1)

    # Read both files in binary mode so every byte is preserved exactly
    with open(sys.argv[1], "rb") as f:
        plaintext = f.read()
    with open(sys.argv[2], "rb") as f:
        key = f.read()

    if len(key) == 0:
        sys.stderr.write("Error: key file is empty\n")
        sys.exit(1)

    # sys.stdout.buffer writes raw bytes (plain print() would corrupt binary data)
    sys.stdout.buffer.write(vigenere_encrypt(plaintext, key))


if __name__ == "__main__":
    main()
